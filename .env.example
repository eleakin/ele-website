# Copy to .env.local and fill in. Never commit real secrets.

# Public site URL — used for canonical metadata, sitemap, robots, OG tags.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Supabase — find these in your project's API settings.
# The publishable key is safe to expose to the browser; it relies on RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
